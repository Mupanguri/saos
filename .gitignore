.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# 7. Local secrets and credentials. Never commit these, in any project.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials.json
service-account*.json
.ghp*
token*.txt

